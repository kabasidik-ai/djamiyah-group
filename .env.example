# ============================================================
# VARIABLES D'ENVIRONNEMENT — Groupe Djamiyah
# ============================================================
# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais commiter .env.local dans Git.

# ============================================================
# === Supabase ===
# ============================================================

# URL publique du projet Supabase (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Clé anonyme Supabase (Dashboard > Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service role Supabase — SERVEUR UNIQUEMENT, jamais côté client
SUPABASE_SERVICE_ROLE_KEY=

# Token d'accès personnel Supabase (pour MCP/CLI uniquement, jamais en production)
SUPABASE_ACCESS_TOKEN=

# ============================================================
# === ChapChapPay ===
# ============================================================

# Clé API ChapChap mode test (sandbox)
CHAPCHAP_API_KEY_TEST=

# Clé API ChapChap mode production
CHAPCHAP_API_KEY_PRODUCTION=

# Secret HMAC pour vérifier les signatures webhook ChapChap
CHAPCHAP_HMAC_SECRET=

# URL de base de l'API ChapChap (défaut: https://chapchappay.com/api)
CHAPCHAP_BASE_URL=

# URL de notification webhook appelée par ChapChap après paiement (défaut: {SITE_URL}/api/payment/webhook)
CHAPCHAP_NOTIFY_URL=

# URL de retour après paiement réussi (défaut: {SITE_URL}/reservation/success)
CHAPCHAP_RETURN_URL=

# URL de retour après annulation de paiement (défaut: {SITE_URL}/reservation)
CHAPCHAP_CANCEL_URL=

# ============================================================
# === Site ===
# ============================================================

# URL publique du site (localhost en dev, https://djamiyahgroup.com en prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# === GoHighLevel — Conversation AI (chatbot Salematou) ===
# ============================================================

# API Token GHL — GHL > Settings > Integrations > API Keys. SERVEUR UNIQUEMENT.
GHL_API_TOKEN=

# Location ID du sous-compte Maison Blanche — GHL > Sub-Account > Settings > Business Profile
GHL_LOCATION_ID=

# Agent ID Salematou — GHL > Conversation AI > Agents > Salematou > Copy Agent ID
GHL_CONVERSATION_AI_AGENT_ID=

# Company ID GHL (requis pour lister les locations)
GHL_COMPANY_ID=

# Token privé legacy GHL (fallback pendant migration OAuth)
GHL_PRIVATE_TOKEN=

# Secret HMAC pour vérifier les webhooks GHL entrants (optionnel)
GHL_WEBHOOK_SECRET=

# ============================================================
# === GoHighLevel — OAuth (optionnel) ===
# ============================================================

# Client ID de l'app OAuth GHL
GHL_CLIENT_ID=

# Client secret de l'app OAuth GHL
GHL_CLIENT_SECRET=

# URI de redirection OAuth GHL (doit correspondre à la config GHL)
GHL_REDIRECT_URI=http://localhost:3000/api/auth/ghl/callback

# URI de redirection OAuth (variante utilisée dans lib/ghl/oauth.ts)
GHL_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/ghl/callback

# ============================================================
# === Admin ===
# ============================================================

# Clé secrète pour les endpoints d'administration (ex: PUT /api/admin/avatar)
ADMIN_SECRET_KEY=

# URL personnalisée de l'avatar Salematou (optionnel, fallback sur image locale)
SALEMATOU_AVATAR_URL=
